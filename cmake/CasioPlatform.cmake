# CasioPlatform.cmake -- platform/architecture tag detection for PlatformTags.h
#
# The emulator and its plugin ABI carry two small compile-time tags:
#
#   CASIOEMU_PLATFORM_OS   one of: macos | linux | windows | android
#   CASIOEMU_PLATFORM_ARCH one of: x64 | x32 | arm64 | arm64-android | any
#
# They are exposed as string literals (quoted compile definitions) so that
# "arm64-android" is representable.  Keep this module in sync with the header
# generated by the plugin-format work (PlatformTags.h).

if(DEFINED CASIOEMU_PLATFORM_CMAKE_INCLUDED)
    return()
endif()
set(CASIOEMU_PLATFORM_CMAKE_INCLUDED TRUE)

# casioemu_detect_platform(<out-os> <out-arch>)
#
# Detects the *target* platform (not the host).  Cross toolchains set
# CMAKE_SYSTEM_NAME so the stock CMake variables are sufficient; the optional
# CASIOEMU_TARGET_OS / CASIOEMU_TARGET_ARCH cache variables from our toolchain
# files are used as hints/fallbacks.
function(casioemu_detect_platform OUT_OS OUT_ARCH)
    set(_os "")
    set(_arch "")

    # --- OS -----------------------------------------------------------------
    if(CASIOEMU_TARGET_OS)
        set(_os "${CASIOEMU_TARGET_OS}")
    elseif(ANDROID OR CMAKE_SYSTEM_NAME STREQUAL "Android")
        set(_os "android")
    elseif(WIN32 OR CMAKE_SYSTEM_NAME STREQUAL "Windows")
        set(_os "windows")
    elseif(APPLE)
        set(_os "macos")
    elseif(UNIX OR CMAKE_SYSTEM_NAME STREQUAL "Linux")
        set(_os "linux")
    else()
        set(_os "any")
    endif()

    # --- Architecture --------------------------------------------------------
    set(_proc "${CMAKE_SYSTEM_PROCESSOR}")
    string(TOLOWER "${_proc}" _proc_lc)

    if(_os STREQUAL "android")
        # Android has its own ABI vocabulary; arm64 gets a dedicated tag.
        if(ANDROID_ABI MATCHES "arm64-v8a")
            set(_arch "arm64-android")
        elseif(ANDROID_ABI MATCHES "armeabi-v7a")
            set(_arch "any")          # 32-bit ARM has no dedicated tag
        elseif(ANDROID_ABI MATCHES "x86_64")
            set(_arch "x64")
        elseif(ANDROID_ABI MATCHES "x86")
            set(_arch "x32")
        else()
            set(_arch "any")
        endif()
    elseif(CASIOEMU_TARGET_ARCH)
        set(_arch "${CASIOEMU_TARGET_ARCH}")
    elseif(_proc_lc MATCHES "^(x86_64|amd64)$")
        set(_arch "x64")
    elseif(_proc_lc MATCHES "^(i[3-6]86|x86)$")
        set(_arch "x32")
    elseif(_proc_lc MATCHES "^(aarch64|arm64)$")
        set(_arch "arm64")
    elseif(CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(_arch "x64")
    elseif(CMAKE_SIZEOF_VOID_P EQUAL 4)
        set(_arch "x32")
    else()
        set(_arch "any")
    endif()

    # A macOS universal binary is deliberately arch-agnostic at the tag level.
    if(_os STREQUAL "macos" AND CMAKE_OSX_ARCHITECTURES MATCHES "arm64" AND
       CMAKE_OSX_ARCHITECTURES MATCHES "x86_64")
        set(_arch "any")
    endif()

    # Validate: typo in a toolchain hint should fail loudly, not silently ship.
    set(_valid_os macos linux windows android any)
    if(NOT _os IN_LIST _valid_os)
        message(FATAL_ERROR "Unsupported CASIOEMU_PLATFORM_OS '${_os}'")
    endif()
    set(_valid_arch x64 x32 arm64 arm64-android any)
    if(NOT _arch IN_LIST _valid_arch)
        message(FATAL_ERROR "Unsupported CASIOEMU_PLATFORM_ARCH '${_arch}'")
    endif()

    set(${OUT_OS} "${_os}" PARENT_SCOPE)
    set(${OUT_ARCH} "${_arch}" PARENT_SCOPE)
endfunction()

# casioemu_apply_platform_tags(<target> [<target> ...])
#
# Applies the two string-literal compile definitions to each existing target.
# Missing targets are skipped so the same call can be used in desktop-only
# blocks without extra guards.
function(casioemu_apply_platform_tags)
    casioemu_detect_platform(_os _arch)
    foreach(_target IN LISTS ARGN)
        if(TARGET ${_target})
            # PlatformTags.h expects C string literals.  CMake strips plain
            # quotes from macro values, so escape them for the compiler driver.
            target_compile_definitions(${_target} PRIVATE
                "CASIOEMU_PLATFORM_OS=\\\"${_os}\\\""
                "CASIOEMU_PLATFORM_ARCH=\\\"${_arch}\\\"")
        endif()
    endforeach()
endfunction()
