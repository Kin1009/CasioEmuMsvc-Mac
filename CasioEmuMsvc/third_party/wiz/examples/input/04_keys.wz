# 04_keys - reading the keyboard: move a box with the arrow keys and print the
# raw scan index. Double buffered.  Line spacing is 8 px.

x = 90
y = 28

def main():
    global x, y
    buffered(1)
    while True:
        if key_down(K_LEFT):
            x -= 2
        if key_down(K_RIGHT):
            x += 2
        if key_down(K_UP):
            y -= 2
        if key_down(K_DOWN):
            y += 2
        x = clamp(x, 1, 185)
        y = clamp(y, 1, 57)
        clear()
        fillrect(x, y, 6, 6)
        print(2, 8, "last key: ", key())
        flip()
        delay(3)
