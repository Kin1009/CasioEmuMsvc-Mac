// 05_pong.cwiz - a tiny one-player pong, to show a real game loop.
//
//   wizrun examples/cwiz/05_pong.cwiz --steps 20000000

const int TOP = 16;
const int BOT = 62;

int px = 88;        // paddle x
int pw = 24;        // paddle width
int bx = 90;        // ball x
int by = 30;        // ball y
int vx = 2;         // ball velocity
int vy = 1;
int score = 0;
int lost = 0;

void reset_ball() {
    bx = 90;
    by = 24;
    vx = 2;
    vy = 1;
}

void main() {
    int frames = 0;

    while (lost == 0 && frames < 4000) {
        frames = frames + 1;

        // paddle follows the arrows
        if (key_down(K_LEFT) && px > 0) { px = px - 4; }
        if (key_down(K_RIGHT) && px + pw < 192) { px = px + 4; }

        // move the ball
        bx = bx + vx;
        by = by + vy;
        if (bx <= 1 || bx >= 189) { vx = 0 - vx; }
        if (by <= TOP) { vy = 0 - vy; }

        // paddle hit?
        if (by >= BOT - 2 && vy > 0) {
            if (bx >= px - 2 && bx <= px + pw + 2) {
                vy = 0 - vy;
                score = score + 1;
            }
        }

        // missed?
        if (by > 63) {
            lost = 1;
        }

        // draw a frame
        clear();
        hline(0, 192, TOP - 1);
        text(0, 2, "score");
        num(40, 2, score);
        fillrect(px, BOT, pw, 4);
        fillrect(bx - 1, by - 1, 3, 3);

        delay(1);
    }

    clear();
    if (lost == 1) {
        text(60, 20, "GAME OVER");
    } else {
        text(60, 20, "TIME UP");
    }
    text(40, 36, "final score");
    num(120, 36, score);
}
