// 04_keys.cwiz - keyboard input with 8 px spacing.
// Build: build/wizc examples/input/04_keys.cwiz

int x = 90;
int y = 28;

void main() {
    buffered(1);
    while (1) {
        if (key_down(K_LEFT)) x -= 2;
        if (key_down(K_RIGHT)) x += 2;
        if (key_down(K_UP)) y -= 2;
        if (key_down(K_DOWN)) y += 2;
        if (x < 1) x = 1; else if (x > 185) x = 185;
        if (y < 1) y = 1; else if (y > 57) y = 57;
        clear();
        fillrect(x, y, 6, 6);
        print(2, 8, "last key: ", key());
        flip();
        delay(3);
    }
}
