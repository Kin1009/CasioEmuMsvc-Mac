# 03_shapes - a tour of every drawing helper the standard library offers.
# Build: build/wizc examples/shapes/03_shapes.wz
#
# The screen is 192 x 64 px, so a 8 px tall text line fits at y = 0, 8, 16, ...
# 56.  Every label below sits on such a line and stays inside the screen.

def main():
    clear()
    rect(0, 0, 192, 64)          # frame: top, bottom and both sides
    line(2, 2, 189, 61)          # Bresenham line
    line(189, 2, 2, 61)          # the other diagonal
    circle(40, 32, 16)           # outline circle
    disc(150, 18, 9)             # filled circle
    fillrect(120, 38, 56, 18)    # filled rectangle
    hline(4, 30, 6)              # horizontal span, y=6
    vline(96, 4, 60)             # vertical span, x=96
    text(4, 48, "shapes")        # 6x8 text, on 8 px line grid
    num(120, 8, -2026)           # signed decimal on y=8 (8 px grid)
