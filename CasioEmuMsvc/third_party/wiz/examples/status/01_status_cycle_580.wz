# Cycle the fx-580VN X status icons one at a time. Press AC to stop.
# Each update touches only the compact status range via renderStatus().
for 580

rom icons = [SHIFT, ALPHA, M, VAR_STO, MATH_INP, DEG, RAD, GRA, FIX, SCI, ENG, IMAG, ANGL, SIMP, LEFT, DOWN, UP, RIGHT, PAUSE, SUN_CHRG]

def main():
    i = 0
    while True:
        for i in range(0, 20):
            setStatus(icons[i], HIGH)
            renderStatus()
            delay(0x20)
            setStatus(icons[i], LOW)
            renderStatus()
            delay(0x10)
            if key_hit(K_AC):
                return
