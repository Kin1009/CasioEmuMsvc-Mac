// 07_preproc.cwiz - the CWiz preprocessor.
//
//   wizc  examples/cwiz/07_preproc.cwiz
//   wizrun examples/cwiz/07_preproc.cwiz          (--target 580 also works)
//
// `#` starts a directive in CWiz (in Wiz it starts a comment). Directives are
// expanded before target sections are picked and before parsing, and they keep
// the line numbering intact, so errors point at the line you wrote.
//
// Run this on both machines: the same source picks a different row count, a
// different label and a different number of bars.

#include "11_hud.cwiz"        // inlined once, thanks to #pragma once

#define WIDTH 40              // object-like macros
#define HEIGHT 8
#define BARS 6
#define BAR_W(i) (2 + (i) * 3)      // function-like: arguments are text
#define AREA (WIDTH * HEIGHT)

#if defined(__CW__)            // predefined by the toolchain, per target
#define MACHINE "fx-580VN X"
#define ROWS 63
#elif defined(__CWII__)
#define MACHINE "fx-880BTG"
#define ROWS 64
#else
#error "this example knows only the 580 and 880 targets"
#endif

#if ROWS < 64
#define SCREEN "63 rows"
#else
#define SCREEN "64 rows"
#endif

#undef HEIGHT                  // drop a macro again
#define HEIGHT 12

int bars[BARS];
int i;

void main() {
    int x = 4;

    // A macro can fill an initialiser list, but keep it simple: use a loop.
    for (i = 0; i < BARS; i = i + 1) {
        bars[i] = BAR_W(i);
    }

    clear();
    text(0, 0, hud_title);                 // from the included file
    print(0, 12, MACHINE, " ", HUD_TAG);
    print(0, 24, SCREEN, " area ", AREA);
    print(0, 36, "hud ", HUD_LINES, " bars ", BARS);

#if defined(HUD_X)
    print(0, 48, "x of bar 3 = ", HUD_X(3));
#endif

    for (i = 0; i < BARS; i = i + 1) {
        fillrect(x, 56 - bars[i], 3, bars[i]);
        x = x + 6;
    }
}
