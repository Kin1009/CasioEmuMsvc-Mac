// rop/04_keys.cwiz — arrow-key menu with keytable.
// Scancodes verified from the firmware: getkey() returns the FCxx key ID from the OS handler.
//   0x0480 = Up, 0x0840 = Down, 0x0440 = Left, 0x0880 = Right.
#rop
#for 580
#org 0xE9E0
#launcher common

int main() {
    setlr();
    setsfr();
    screen_del();
loop:
    getkey();
    keytable(0x0480, up, 0x0840, down, 0x0440, left, 0x0880, right, 0x0000, loop);
up:
    screen_del();
    print(0x30, 0x21, "Up");
    render();
    goto loop;
down:
    screen_del();
    print(0x30, 0x21, "Down");
    render();
    goto loop;
left:
    screen_del();
    print(0x30, 0x21, "Left");
    render();
    goto loop;
right:
    screen_del();
    print(0x30, 0x21, "Right");
    render();
    goto loop;
}
