// rop/06_rop_keys.cwiz — getkey/keytable menu with the real arrow scancodes.
//
// getkey() writes the KI/KO word into an inline slot and leaves it in ER0; keytable() compares it with cmp_ea and branches to the label.
//
//   0x0480 = Up, 0x0840 = Down, 0x0440 = Left, 0x0880 = Right.
#rop
#for 580
#org E9E0
#launcher common

int main() {
    setlr();
    setsfr();
    screen_del();
    print(0x30, 0x01, "PRESS A KEY");
    render();
loop:
    getkey();
    keytable(0x0480, up,
             0x0840, down,
             0x0440, left,
             0x0880, right,
             0x0000, loop);
up:
    screen_del();
    print(0x30, 0x11, "UP");
    render();
    goto loop;
down:
    screen_del();
    print(0x30, 0x11, "DOWN");
    render();
    goto loop;
left:
    screen_del();
    print(0x30, 0x11, "LEFT");
    render();
    goto loop;
right:
    screen_del();
    print(0x30, 0x11, "RIGHT");
    render();
    goto loop;
}
