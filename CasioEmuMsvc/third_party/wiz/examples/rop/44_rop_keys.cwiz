// rop/06_rop_keys.cwiz — getkey/keytable menu with the real arrow scancodes.
//
// getkey() calls the OS key handler and leaves the FCxx key ID in ER0; keytable() compares it with cmp_ea and branches to the label.
//
//   0xFC1F = Up, 0xFC1E = Down, 0xFC1C = Left, 0xFC1D = Right.
#rop
#for 580
#org E9E0
#launcher common

int main() {
    setlr();
    setsfr();
    screen_del();
    print(0x30, 0x01, "PRESS A KEY");
    render();
loop:
    getkey();
    keytable(0xFC1F, up,
             0xFC1E, down,
             0xFC1C, left,
             0xFC1D, right,
             0x0000, loop);
up:
    screen_del();
    print(0x30, 0x11, "UP");
    render();
    goto loop;
down:
    screen_del();
    print(0x30, 0x11, "DOWN");
    render();
    goto loop;
left:
    screen_del();
    print(0x30, 0x11, "LEFT");
    render();
    goto loop;
right:
    screen_del();
    print(0x30, 0x11, "RIGHT");
    render();
    goto loop;
}
