// 07_cwapp.cwiz - a fw-app for fx-580VN X with #cwapp, #slot and exit().
//
// Build to a complete patched ROM (writes .bin next to source, not over stock ROM):
//
//   WIZ_ROOT=$PWD ./build/wizc examples/cwapp/07_cwapp.cwiz -o /tmp/07_cwapp.bin
//
// The embedded 580 ROM inside wizc is patched in memory; the stock file is untouched.

#for 580
void leave() { }
#cwapp
#slot 2
void leave() { exit(); }
----

void draw() {
    clear();
    rect(0, 0, 192, 64);
    text(24, 20, "Hello from cwapp");
    text(24, 32, "press AC to exit");
}

void main() {
    draw();
    while (1) {
        if (key_down(K_AC)) { leave(); }
        delay(3);
    }
}
