# 09_cwapp.wz - Wiz version of the fw-app (uses `for cwapp` section).
# Build with: WIZ_ROOT=$PWD ./build/wizc examples/cwapp/09_cwapp.wz

for cwapp
def leave():
    exit()

----

def draw():
    clear()
    rect(0, 0, 192, 64)
    text(24, 20, "Hello from Wiz")
    text(24, 32, "press AC to exit")

def main():
    draw()
    while True:
        if key_down(K_AC):
            leave()
        delay(3)
