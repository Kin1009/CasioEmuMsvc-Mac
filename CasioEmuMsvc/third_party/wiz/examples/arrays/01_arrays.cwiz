// arrays/01_arrays.cwiz — RAM arrays with rom8 / rom int.
const int N = 10;
int values[N];
rom int squares[11] = {0,1,4,9,16,25,36,49,64,81,100};

// Shadow mechanism: draw to SB2, call render() to flush SB2 -> SB1 (F800)
void main() {
    int i;
    int total;
    for (i = 0; i <= 10; i = i + 1) values[i] = squares[i];
    total = 0;
    for (i = 0; i <= 10; i = i + 1) total = total + values[i];
    clear();
    text(0, 8, "Arrays demo");
    print(0, 24, "sum 0..10 = ", total);
    num(0, 40, values[7]);
    render();
    wait_key();
}
