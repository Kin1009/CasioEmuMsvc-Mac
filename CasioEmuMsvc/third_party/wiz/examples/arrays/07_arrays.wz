# 05_arrays - RAM arrays, rom8 strings, 8 px line spacing.

squares = [0] * 6
rom8 title = "sum of squares"

def main():
    total = 0
    for i in range(0, 6):
        squares[i] = (i + 1) * (i + 1)
        total += squares[i]
    clear()
    text(4, 8, title)
    for i in range(0, 6):
        fillrect(12 + i * 20, 40 - squares[i], 10, squares[i])
    print(4, 48, "total = ", total)
