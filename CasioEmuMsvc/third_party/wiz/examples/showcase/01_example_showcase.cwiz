// A broad CWiz tour: ROM arrays, helpers, arithmetic, graphics, sprites,
// native CW Display text, key edges, status icons, and explicit rendering.
const int SAMPLE_COUNT = 5;
rom int samples[SAMPLE_COUNT] = {3, 5, 8, 13, 21};
rom8 char badge[8] = {0x3C, 0x42, 0xA5, 0x81, 0xA5, 0x99, 0x42, 0x3C};

int sum_samples() {
    int i;
    int total = 0;
    for (i = 0; i < SAMPLE_COUNT; i = i + 1) total = total + samples[i];
    return total;
}

void draw_scene(int cursor, int total, int frame) {
    clear();
    rect(0, 0, 192, 64);
    text(5, 4, "Wiz / CWiz showcase");
    print(5, 15, "ROM sum: ", total);
    line(5, 29, 186, 29);
    circle(28, 45, 8);
    fillrect(48, 39, 22, 13);
    pixel(81, 45, 1);
    sprite(96, 37, 8, 8, badge);
    text_cw(112, 37, "CW font");
    print_cw(112, 51, "frame ", frame);
    pixel(cursor, 31, 1);
    if (frame & 1) { setStatus(SHIFT, HIGH); }
    else { setStatus(SHIFT, LOW); }
    render();
    renderStatus();
}

void main() {
    int cursor = 8;
    int frame = 0;
    int total = sum_samples();
    while (1) {
        draw_scene(cursor, total, frame);
        if (key_hit(K_LEFT)) cursor = cursor - 2;
        if (key_hit(K_RIGHT)) cursor = cursor + 2;
        if (cursor < 1) cursor = 1;
        if (cursor > 190) cursor = 190;
        frame = frame + 1;
        if (key_hit(K_AC)) break;
        delay(3);
    }
    setStatus(SHIFT, LOW);
    renderStatus();
}
